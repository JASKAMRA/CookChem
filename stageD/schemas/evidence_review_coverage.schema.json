{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cookrisk:schema:evidence_review_coverage:1.0.0",
  "title": "CookRisk human review coverage dashboard",
  "description": "Counts source-pinned machine triage and explicit reviewer actions without treating machine labels as decisions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_release_id", "source_sha256", "record_count", "machine_triage_counts", "human_review_status_counts", "source_verification_status_counts", "machine_source_polarity_counts", "reviewed_record_count", "not_reviewed_record_count", "review_coverage_fraction", "audit_action_count", "audit_head_sha256", "expert_accepted_count", "expert_rejected_count", "automatic_approval_count", "automatic_negative_inference_count", "negative_assessments_require_human_action"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "source_release_id": {"const": "StageB_V20_20261103"},
    "source_sha256": {"const": "5c095c6ee22d8d998888d3d47bc4ae2fcabf17faf4df0bee8aad7d6bb9af1cec"},
    "record_count": {"const": 317},
    "machine_triage_counts": {"$ref": "#/$defs/countMap"},
    "human_review_status_counts": {"$ref": "#/$defs/countMap"},
    "source_verification_status_counts": {"$ref": "#/$defs/countMap"},
    "machine_source_polarity_counts": {"$ref": "#/$defs/countMap"},
    "reviewed_record_count": {"type": "integer", "minimum": 0, "maximum": 317},
    "not_reviewed_record_count": {"type": "integer", "minimum": 0, "maximum": 317},
    "review_coverage_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "audit_action_count": {"type": "integer", "minimum": 0},
    "audit_head_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "expert_accepted_count": {"type": "integer", "minimum": 0, "maximum": 317},
    "expert_rejected_count": {"type": "integer", "minimum": 0, "maximum": 317},
    "automatic_approval_count": {"const": 0},
    "automatic_negative_inference_count": {"const": 0},
    "negative_assessments_require_human_action": {"const": true}
  },
  "$defs": {"countMap": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 317}}}
}
