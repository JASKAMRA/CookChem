          "journalIssueId": 718320,
          "dateOfPublication": "1993 Sep",
          "monthOfPublication": 9,
          "yearOfPublication": 1993,
          "journal": {
            "medlineAbbreviation": "J Pharm Sci",
            "title": "Journal of pharmaceutical sciences",
