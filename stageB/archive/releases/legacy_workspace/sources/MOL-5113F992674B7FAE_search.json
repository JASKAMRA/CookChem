      {
        "id": "PPR1160690",
        "source": "PPR",
        "doi": "10.20944/preprints202602.2029.v1",
        "title": "Pharmacokinetic Profiles of Orally Bioavailable Natural Compounds for Integration into Biomedical Cancer Drug Discovery Research",
        "authorString": "Manoharan S.",
        "authorList": {
          "author": [
            {
              "fullName": "Manoharan S",
              "lastName": "Manoharan",
              "firstName": "Sivananthan",
              "initials": "S"
