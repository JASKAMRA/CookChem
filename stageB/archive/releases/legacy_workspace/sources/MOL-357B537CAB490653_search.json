        "journalInfo": {
          "issue": "1",
          "volume": "45",
          "journalIssueId": 1992514,
          "dateOfPublication": "2013 Jan",
          "monthOfPublication": 1,
          "yearOfPublication": 2013,
          "journal": {
            "medlineAbbreviation": "Int J Biochem Cell Biol",
            "title": "The international journal of biochemistry & cell biology",
            "essn": "1878-5875",
            "issn": "1357-2725",
