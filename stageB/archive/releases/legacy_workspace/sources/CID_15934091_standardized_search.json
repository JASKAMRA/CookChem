      {
        "id": "IND500736993",
        "source": "AGR",
        "title": "Isolation and purification of isoflavones from soy flour by high-speed countercurrent chromatography",
        "authorString": "Degenhardt A, Winterhalter P.",
        "authorList": {
          "author": [
            {
              "fullName": "Degenhardt A",
              "lastName": "Degenhardt",
              "firstName": "Andreas",
              "initials": "A"
