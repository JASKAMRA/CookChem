          "dateOfPublication": "2011 Dec",
          "monthOfPublication": 12,
          "yearOfPublication": 2011,
          "journal": {
            "medlineAbbreviation": "Drug Metab Dispos",
            "title": "Drug metabolism and disposition: the biological fate of chemicals",
            "essn": "1521-009X",
