{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cookrisk.local/schemas/phase2_source_pair_audit.schema.json",
  "title": "CookRisk Phase 2 source-pair audit row",
  "type": "object",
  "required": [
    "pair_id", "source_doi", "source_locator", "compound_name", "food_matrix",
    "cooking_method", "raw_mean_value", "cooked_mean_value", "measurement_unit",
    "replicates_n", "independently_recalculated_ratio",
    "source_verification_status", "audit_error_codes"
  ],
  "properties": {
    "pair_id": {"type": "string", "minLength": 1},
    "source_doi": {"type": "string", "minLength": 1},
    "source_locator": {"type": "string", "minLength": 1},
    "compound_name": {"type": "string", "minLength": 1},
    "food_matrix": {"type": "string", "minLength": 1},
    "cooking_method": {"type": "string", "minLength": 1},
    "raw_mean_value": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$"},
    "cooked_mean_value": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$"},
    "measurement_unit": {"type": "string", "minLength": 1},
    "replicates_n": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "independently_recalculated_ratio": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "independently_recalculated_ratio_percent": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "source_verification_status": {"enum": ["VERIFIED_AGAINST_PRIMARY_TABLE", "VERIFIED_WITH_BASIS_LIMITATION", "REVIEW_REQUIRED"]},
    "audit_error_codes": {"type": "string"}
  },
  "additionalProperties": true
}
