        "journalInfo": {
          "issue": "Pt 3",
          "volume": "386",
          "journalIssueId": 1221417,
          "dateOfPublication": "2005 Mar",
          "monthOfPublication": 3,
          "yearOfPublication": 2005,
          "journal": {
            "medlineAbbreviation": "Biochem J",
            "title": "The Biochemical journal",
            "essn": "1470-8728",
            "issn": "0264-6021",
            "isoabbreviation": "Biochem J",
            "nlmid": "2984726R"
