{
  "openapi": "3.1.0",
  "info": {
    "title": "CookRisk non-production API contract draft",
    "version": "0.1.0-draft",
    "description": "Design artifact only; no production service. No clinical interpretation, unsupported cooked estimates, dose ratio, or risk score is exposed."
  },
  "servers": [
    { "url": "https://api.example.invalid", "description": "Reserved placeholder; not deployed" }
  ],
  "paths": {
    "/v1/exposure-previews": {
      "post": {
        "summary": "Request a food exposure calculation preview",
        "operationId": "createExposurePreview",
        "description": "Uses pinned Stage C releases. Cooked estimates require compatible accepted Phase 2 evidence and required measured basis inputs; otherwise status is blocked or incomplete.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExposurePreviewRequest" } } }
        },
        "responses": {
          "200": { "description": "Preview result or explicit blocked state", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExposurePreviewResponse" } } } },
          "400": { "description": "Invalid identifiers, units, or input contract" },
          "409": { "description": "Release or source compatibility cannot be established" }
        }
      }
    },
    "/v1/comparability-assessments": {
      "post": {
        "summary": "Create a non-clinical comparability gate assessment",
        "operationId": "createComparabilityAssessment",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ComparabilityRequest" } } }
        },
        "responses": {
          "200": { "description": "Pending, rejected, or ready for human review", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ComparabilityResponse" } } } },
          "400": { "description": "Invalid source IDs, hashes, units, or gate values" },
          "409": { "description": "Exposure and evidence provenance do not match" }
        }
      }
    },
    "/v1/reports": {
      "post": {
        "summary": "Create a provenance-complete export",
        "operationId": "createReportExport",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReportRequest" } } }
        },
        "responses": {
          "200": { "description": "JSON or tabular export plus integrity metadata", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReportResponse" } } } },
          "400": { "description": "Unsupported format or missing provenance" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ReleaseReference": {
        "type": "object",
        "required": ["release_id", "manifest_sha256"],
        "properties": {
          "release_id": { "type": "string", "minLength": 1 },
          "manifest_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
        },
        "additionalProperties": false
      },
      "ExposurePreviewRequest": {
        "type": "object",
        "required": ["phase1b", "phase2", "ingredients"],
        "properties": {
          "phase1b": { "$ref": "#/components/schemas/ReleaseReference" },
          "phase2": { "$ref": "#/components/schemas/ReleaseReference" },
          "ingredients": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["food_record_id", "compound_id", "quantity", "quantity_unit", "ingredient_state"], "properties": { "food_record_id": { "type": "string" }, "compound_id": { "type": "string" }, "quantity": { "type": ["number", "string"] }, "quantity_unit": { "type": "string" }, "consumed_fraction": { "type": ["number", "string", "null"] }, "ingredient_state": { "enum": ["raw", "cooked", "prepared", "unknown"] }, "cooking_conditions": { "type": ["object", "null"] }, "measured_raw_mass": { "type": ["object", "null"] }, "measured_cooked_mass": { "type": ["object", "null"] } }, "additionalProperties": false } }
        },
        "additionalProperties": false
      },
      "ExposurePreviewResponse": {
        "type": "object",
        "required": ["status", "result", "provenance", "source_records", "uncertainty", "warnings", "missing_inputs", "clinical_interpretation"],
        "properties": {
          "status": { "enum": ["COMPLETE_RAW", "COMPLETE_SUPPORTED_COOKED", "BLOCKED_COOKED", "INCOMPLETE_INPUT"] },
          "result": { "type": ["object", "null"], "description": "Amounts and bounds with explicit units; null when blocked or incomplete, never zero-filled." },
          "provenance": { "type": "array", "items": { "$ref": "#/components/schemas/ReleaseReference" } },
          "source_records": { "type": "array", "items": { "type": "object", "required": ["stage", "record_id", "source_reference"], "properties": { "stage": { "type": "string" }, "record_id": { "type": "string" }, "source_reference": { "type": "string" } }, "additionalProperties": false } },
          "uncertainty": { "$ref": "#/components/schemas/UncertaintySummary" },
          "warnings": { "type": "array", "items": { "type": "string" } },
          "missing_inputs": { "type": "array", "items": { "type": "string" } },
          "clinical_interpretation": { "const": "not_performed" }
        },
        "additionalProperties": false
      },
      "UncertaintySummary": {
        "type": "object",
        "required": ["status", "intervals", "missing_uncertainty"],
        "properties": {
          "status": { "enum": ["available", "partially_available", "not_available"] },
          "intervals": { "type": "array", "items": { "type": "object", "required": ["input_id", "uncertainty_type", "lower", "upper", "unit", "source_reference"], "properties": { "input_id": { "type": "string" }, "uncertainty_type": { "enum": ["source_reported_range", "analytical_measurement_variability", "literature_derived_range", "scenario_bound", "model_prediction_uncertainty"] }, "lower": { "type": ["number", "string"] }, "upper": { "type": ["number", "string"] }, "unit": { "type": "string" }, "source_reference": { "type": "string" }, "probability_distribution": { "type": "null", "description": "No distribution is implied by an interval." } }, "additionalProperties": false } },
          "missing_uncertainty": { "type": "array", "items": { "type": "object", "required": ["input_id", "reason"], "properties": { "input_id": { "type": "string" }, "reason": { "type": "string" } }, "additionalProperties": false } }
        },
        "additionalProperties": false
      },
      "ComparabilityRequest": {
        "type": "object",
        "required": ["exposure_id", "phase3", "evidence_id", "stage_b", "criteria"],
        "properties": {
          "exposure_id": { "type": "string", "minLength": 1 },
          "phase3": { "$ref": "#/components/schemas/ReleaseReference" },
          "evidence_id": { "type": "string", "minLength": 1 },
          "stage_b": { "$ref": "#/components/schemas/ReleaseReference" },
          "criteria": { "$ref": "#/components/schemas/ComparabilityCriteria" },
          "reviewer_reference": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      },
      "ComparabilityCriteria": {
        "type": "object",
        "required": ["compound_identity", "exposure_route", "dose_units_and_basis", "time_window", "population_or_model", "preparation_or_matrix"],
        "properties": {
          "compound_identity": { "type": ["boolean", "null"] },
          "exposure_route": { "type": ["boolean", "null"] },
          "dose_units_and_basis": { "type": ["boolean", "null"] },
          "time_window": { "type": ["boolean", "null"] },
          "population_or_model": { "type": ["boolean", "null"] },
          "preparation_or_matrix": { "type": ["boolean", "null"] }
        },
        "additionalProperties": false
      },
      "ComparabilityResponse": {
        "type": "object",
        "required": ["schema_version", "comparison_id", "exposure_id", "evidence_id", "criteria", "decision", "decision_reason", "review_status", "clinical_interpretation"],
        "properties": {
          "schema_version": { "const": "1.1.0" },
          "comparison_id": { "type": "string" },
          "exposure_id": { "type": "string" },
          "evidence_id": { "type": "string" },
          "criteria": { "$ref": "#/components/schemas/ComparabilityCriteria" },
          "decision": { "enum": ["PENDING", "REJECTED", "READY_FOR_REVIEW"] },
          "decision_reason": { "type": "string" },
          "review_status": { "enum": ["automated_check_only", "human_review_pending", "human_reviewed"] },
          "clinical_interpretation": { "const": "not_performed" }
        },
        "additionalProperties": true
      },
      "ReportRequest": {
        "type": "object",
        "required": ["record_type", "record_id", "format"],
        "properties": {
          "record_type": { "enum": ["exposure", "comparability"] },
          "record_id": { "type": "string" },
          "format": { "enum": ["json", "csv", "pdf"] }
        },
        "additionalProperties": false
      },
      "ReportResponse": {
        "type": "object",
        "required": ["format", "schema_version", "content", "sha256", "provenance_complete"],
        "properties": {
          "format": { "enum": ["json", "csv", "pdf"] },
          "schema_version": { "type": "string" },
          "content": { "type": ["object", "string"] },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "provenance_complete": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  }
}
